# Nothing here is required: copy to .env.local only to change a default.

# SQLite database file (optional, default data/notes.db, relative to the
# project root). Created with its tables on first start.
# DATABASE_PATH="data/notes.db"

# Don't set PORT here: it would also move `pnpm dev` off 3000. The production
# port (8009) is set by scripts/start.ps1 (see README).

# Name shown in the header and browser tab (optional, default "Notes").
# Build-time: restart dev / rebuild after changing it.
# VITE_APP_NAME="Notes"
